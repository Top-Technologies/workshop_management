            <field name="name">Workshop Request: Technician – Assigned Only</field>
            <field name="model_id" ref="model_workshop_request"/>
            <field name="domain_force">['|', '|', '|',
                ('user_id', '=', user.id),
                ('job_order_ids.user_id', '=', user.id),
                ('job_order_ids.work_order_ids.user_id', '=', user.id),
