<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Technicians: see WOs assigned to their user OR their employee record -->
        <record id="rule_work_order_technician" model="ir.rule">
            <field name="name">Work Order: Technician – Own Only</field>
            <field name="model_id" ref="model_workshop_work_order"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('technician_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_workshop_technician'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Supervisors: see all Work Orders -->
        <record id="rule_work_order_supervisor" model="ir.rule">
            <field name="name">Work Order: Supervisor – All</field>
            <field name="model_id" ref="model_workshop_work_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_workshop_supervisor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Multi-company rules -->
        <record id="rule_workshop_request_company" model="ir.rule">
            <field name="name">Workshop Request: Multi-Company</field>
            <field name="model_id" ref="model_workshop_request"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_workshop_job_order_company" model="ir.rule">
            <field name="name">Job Order: Multi-Company</field>
            <field name="model_id" ref="model_workshop_job_order"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_workshop_work_order_company" model="ir.rule">
            <field name="name">Work Order: Multi-Company</field>
            <field name="model_id" ref="model_workshop_work_order"/>
