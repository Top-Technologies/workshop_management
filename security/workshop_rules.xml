            <field name="model_id" ref="model_workshop_field_visit"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Technicians: Job Orders they own or have a Work Order on -->
        <record id="rule_job_order_technician" model="ir.rule">
            <field name="name">Job Order: Technician – Assigned Only</field>
            <field name="model_id" ref="model_workshop_job_order"/>
            <field name="domain_force">['|', '|',
                ('user_id', '=', user.id),
                ('work_order_ids.user_id', '=', user.id),
                ('work_order_ids.technician_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_workshop_technician'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
