        <record id="rule_workshop_expense_technician" model="ir.rule">
            <field name="name">Field Expense: Technician – Own</field>
            <field name="model_id" ref="model_workshop_expense"/>
            <field name="domain_force">[('submitted_by_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_workshop_technician'))]"/>
            <field name="perm_read" eval="True"/>
