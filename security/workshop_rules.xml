        <record id="rule_workshop_customer_type_company" model="ir.rule">
            <field name="name">Customer Type: Multi-Company</field>
            <field name="model_id" ref="model_workshop_customer_type"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_workshop_labor_rate_rule_company" model="ir.rule">
