<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_workshop_hourly_cost" model="ir.ui.view">
        <field name="name">hr.employee.form.workshop.hourly.cost</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Workshop Costing" name="workshop_costing_group">
                    <field name="hourly_cost"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
