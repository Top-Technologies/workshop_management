<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="workshop_expense_view_list" model="ir.ui.view">
        <field name="name">workshop.expense.list</field>
        <field name="model">workshop.expense</field>
        <field name="arch" type="xml">
            <list string="Field Expenses"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'submitted'"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'refused'">
                <field name="name"/>
                <field name="date"/>
                <field name="job_order_id"/>
                <field name="submitted_by_id"/>
                <field name="expense_type"/>
                <field name="description"/>
                <field name="amount" sum="Cost"/>
                <field name="billable_amount" sum="Billable"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'refused'"/>
            </list>
        </field>
    </record>

    <record id="workshop_expense_view_search" model="ir.ui.view">
        <field name="name">workshop.expense.search</field>
        <field name="model">workshop.expense</field>
        <field name="arch" type="xml">
            <search string="Field Expenses">
                <field name="name"/>
                <field name="job_order_id"/>
                <field name="description"/>
                <field name="submitted_by_id"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Waiting Foreman" name="filter_submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Refused" name="filter_refused" domain="[('state', '=', 'refused')]"/>
                <separator/>
                <filter string="My Expenses" name="filter_mine" domain="[('submitted_by_id', '=', uid)]"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Job Order" name="group_job" context="{'group_by': 'job_order_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'expense_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="workshop_expense_view_form" model="ir.ui.view">
        <field name="name">workshop.expense.form</field>
        <field name="model">workshop.expense</field>
        <field name="arch" type="xml">
            <form string="Field Expense">
                <header>
                    <button name="action_submit" string="Submit to Foreman" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="btn-success" invisible="state != 'submitted'"
                            groups="workshop_management.group_workshop_supervisor"/>
                    <button name="action_refuse" string="Refuse" type="object"
                            class="btn-danger" invisible="state != 'submitted'"
                            groups="workshop_management.group_workshop_supervisor"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state != 'refused'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Job">
                            <field name="job_order_id"/>
                            <field name="partner_id"/>
                            <field name="equipment_id"/>
                            <field name="employee_id"/>
                            <field name="submitted_by_id"/>
                        </group>
                        <group string="Expense">
                            <field name="date"/>
                            <field name="expense_type"/>
                            <field name="description"/>
                            <field name="amount"/>
                            <field name="margin_percent"/>
                            <field name="billable_amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="sale_line_id" readonly="1"
                                   invisible="not sale_line_id"/>
                            <field name="approved_by_id" invisible="state == 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Receipts" name="receipts">
                        <field name="receipt_ids" widget="many2many_binary" nolabel="1"
                               string="Scan or photo of the receipt"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="What was purchased, why it was needed..."/>
                        <field name="refuse_reason" invisible="state != 'refused'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="workshop_expense_action" model="ir.actions.act_window">
        <field name="name">Field Expenses</field>
        <field name="res_model">workshop.expense</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_submitted': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Submit a field expense
            </p>
            <p>
                Field staff upload personal-money receipts against a Job Order.
                The Foreman (Supervisor) validates them; approved cost plus the
                company margin is billed to the customer.
            </p>
        </field>
    </record>

    <record id="workshop_expense_action_pending" model="ir.actions.act_window">
        <field name="name">Expenses Waiting Foreman</field>
        <field name="res_model">workshop.expense</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'submitted')]</field>
        <field name="context">{}</field>
    </record>

</odoo>
