<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="workshop_approval_rule_view_list" model="ir.ui.view">
        <field name="name">workshop.approval.rule.list</field>
        <field name="model">workshop.approval.rule</field>
        <field name="arch" type="xml">
            <list string="Approval Rules">
                <field name="name"/>
                <field name="amount_threshold" widget="monetary"/>
                <field name="group_id"/>
                <field name="category_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="workshop_approval_rule_view_form" model="ir.ui.view">
        <field name="name">workshop.approval.rule.form</field>
        <field name="model">workshop.approval.rule</field>
        <field name="arch" type="xml">
            <form string="Approval Rule">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="amount_threshold" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="group_id"/>
                            <field name="category_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="workshop_approval_rule_action" model="ir.actions.act_window">
        <field name="name">Approval Rules</field>
        <field name="res_model">workshop.approval.rule</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
