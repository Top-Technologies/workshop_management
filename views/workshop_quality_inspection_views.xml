<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="workshop_quality_inspection_view_list" model="ir.ui.view">
        <field name="name">workshop.quality.inspection.list</field>
        <field name="model">workshop.quality.inspection</field>
        <field name="arch" type="xml">
            <list string="Quality Inspections" decoration-muted="state == 'fail'">
                <field name="name"/>
                <field name="job_order_id"/>
                <field name="work_order_id"/>
                <field name="inspector_id"/>
                <field name="date_inspection"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'pass'"
                       decoration-danger="state == 'fail'"/>
            </list>
        </field>
    </record>

    <record id="workshop_quality_inspection_view_search" model="ir.ui.view">
        <field name="name">workshop.quality.inspection.search</field>
        <field name="model">workshop.quality.inspection</field>
        <field name="arch" type="xml">
            <search string="Quality Inspections">
                <field name="name"/>
                <field name="job_order_id"/>
                <field name="work_order_id"/>
                <field name="inspector_id"/>

                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Passed" name="filter_pass"
                        domain="[('state', '=', 'pass')]"/>
                <filter string="Failed" name="filter_fail"
                        domain="[('state', '=', 'fail')]"/>

                <separator/>
                <filter string="Open Inspections" name="filter_open"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="My Inspections" name="filter_my_inspections"
                        domain="[('inspector_id', '=', uid)]"/>
                <filter string="Today" name="filter_today"
                        domain="[('date_inspection', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
                                 ('date_inspection', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>

                <group>
                    <filter string="Result" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Job Order" name="group_job_order"
                            context="{'group_by': 'job_order_id'}"/>
                    <filter string="Work Dispatch" name="group_work_order"
                            context="{'group_by': 'work_order_id'}"/>
                    <filter string="Inspector" name="group_inspector"
                            context="{'group_by': 'inspector_id'}"/>
                    <filter string="Inspection Date" name="group_date"
                            context="{'group_by': 'date_inspection:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="workshop_quality_inspection_view_search" model="ir.ui.view">
        <field name="name">workshop.quality.inspection.search</field>
        <field name="model">workshop.quality.inspection</field>
        <field name="arch" type="xml">
            <search string="Quality Inspections">
                <field name="name"/>
                <field name="job_order_id"/>
                <field name="work_order_id"/>
                <field name="inspector_id"/>

                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Passed" name="filter_pass"
                        domain="[('state', '=', 'pass')]"/>
                <filter string="Failed" name="filter_fail"
                        domain="[('state', '=', 'fail')]"/>

                <separator/>
                <filter string="My Inspections" name="filter_my_inspections"
                        domain="[('inspector_id', '=', uid)]"/>

                <group>
                    <filter string="Result" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Job Order" name="group_job_order"
                            context="{'group_by': 'job_order_id'}"/>
                    <filter string="Work Dispatch" name="group_work_order"
                            context="{'group_by': 'work_order_id'}"/>
                    <filter string="Inspector" name="group_inspector"
                            context="{'group_by': 'inspector_id'}"/>
                    <filter string="Inspection Date" name="group_date"
                            context="{'group_by': 'date_inspection:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="workshop_quality_inspection_view_form" model="ir.ui.view">
        <field name="name">workshop.quality.inspection.form</field>
        <field name="model">workshop.quality.inspection</field>
        <field name="arch" type="xml">
            <form string="Quality Inspection">
                <header>
                    <button name="action_load_checklist" string="Load Checklist Template" type="object"
                            invisible="state != 'draft'"/>
                    <button name="action_pass" string="Pass Inspection" type="object" class="btn-success"
                            invisible="state != 'draft'"/>
                    <button name="action_fail" string="Fail Inspection" type="object" class="btn-danger"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pass,fail"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Inspection Reference">
                            <field name="job_order_id"/>
                            <field name="work_order_id"/>
                        </group>
                        <group string="Inspector &amp; Date">
                            <field name="inspector_id" widget="many2one_avatar_user"/>
                            <field name="date_inspection"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Checklist Items" name="checklist">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="passed"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Photos / Documents" name="attachments">
                            <div class="alert alert-info" role="alert" invisible="id">
                                Save the inspection first, then upload photos and documents.
                            </div>
                            <field name="attachment_ids"
                                   widget="many2many_binary"
                                   invisible="not id"
                                   options="{'accepted_file_extensions': 'image/*,application/pdf'}"/>
                        </page>
                        <page string="Remarks" name="remarks">
                            <field name="notes" placeholder="Overall quality inspector remarks..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="workshop_quality_inspection_action" model="ir.actions.act_window">
        <field name="name">Quality Inspections</field>
        <field name="res_model">workshop.quality.inspection</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="workshop_quality_checklist_item_view_list" model="ir.ui.view">
        <field name="name">workshop.quality.checklist.item.list</field>
        <field name="model">workshop.quality.checklist.item</field>
        <field name="arch" type="xml">
            <list string="QI Checklist Templates" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="department"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="workshop_quality_checklist_item_action" model="ir.actions.act_window">
        <field name="name">QI Checklist Templates</field>
        <field name="res_model">workshop.quality.checklist.item</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
