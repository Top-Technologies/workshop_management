<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_sale_order_job_orders" model="ir.actions.act_window">
        <field name="name">Job Orders</field>
        <field name="res_model">workshop.job.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('sale_order_id', '=', active_id)]</field>
        <field name="context">{'default_sale_order_id': active_id}</field>
    </record>

    <record id="sale_order_view_form_inherit_workshop" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.workshop</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="workshop_request_id" readonly="1" invisible="workshop_request_id == False"/>
                <field name="is_warranty_order" invisible="workshop_request_id == False"/>
                <field name="is_agreement_order" invisible="workshop_request_id == False"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(action_sale_order_job_orders)d" type="action" class="oe_stat_button" icon="fa-wrench"
                        invisible="job_order_id == False" string="Job Order">
                    <field name="job_order_id" invisible="1"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='order_line']//list//field[@name='price_unit']" position="after">
                <field name="workshop_coverage" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
