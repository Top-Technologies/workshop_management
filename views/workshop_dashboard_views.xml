<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================================
         1. PROCESS STAGES VISUAL GRAPH (PIE CHART) DASHBOARD
         ===================================================================== -->
    <record id="workshop_job_order_view_graph_pie" model="ir.ui.view">
        <field name="name">workshop.job.order.graph.pie</field>
        <field name="model">workshop.job.order</field>
        <field name="arch" type="xml">
            <graph string="Process Lifecycle Stages" type="pie" sample="1">
                <field name="state"/>
                <field name="total_cost" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- =====================================================================
         2. PROCESS PERFORMANCE BAR CHART & PIVOT ANALYTICS
         ===================================================================== -->
    <record id="workshop_job_order_view_graph_bar" model="ir.ui.view">
        <field name="name">workshop.job.order.graph.bar</field>
        <field name="model">workshop.job.order</field>
        <field name="arch" type="xml">
            <graph string="Job Costs &amp; Profitability by Customer" type="bar" sample="1">
                <field name="partner_id"/>
                <field name="job_profitability" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="workshop_job_order_view_pivot" model="ir.ui.view">
        <field name="name">workshop.job.order.pivot</field>
        <field name="model">workshop.job.order</field>
        <field name="arch" type="xml">
            <pivot string="Job Order Process Analytics">
                <field name="partner_id" type="row"/>
                <field name="state" type="col"/>
                <field name="planned_hours" type="measure"/>
                <field name="actual_hours" type="measure"/>
                <field name="labor_cost" type="measure"/>
                <field name="parts_cost" type="measure"/>
                <field name="quoted_amount" type="measure"/>
                <field name="total_cost" type="measure"/>
                <field name="expected_profit" type="measure"/>
                <field name="job_profitability" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- =====================================================================
         3. PROCESS KANBAN PIPELINE VIEW
         ===================================================================== -->
    <record id="workshop_job_order_view_kanban" model="ir.ui.view">
        <field name="name">workshop.job.order.kanban</field>
        <field name="model">workshop.job.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_dashboard o_workshop_kanban">
                <field name="id"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="equipment_id"/>
                <field name="priority"/>
                <field name="approval_state"/>
                <field name="state"/>
                <field name="planned_hours"/>
                <field name="actual_hours"/>
                <field name="total_cost"/>
                <field name="currency_id"/>
                <field name="user_id"/>
                <field name="vehicle_released"/>
                <field name="payment_pending"/>
                <field name="vehicle_release_mode"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title fs-5">
                                        <field name="name"/>
                                    </strong>
                                    <span class="text-muted d-block">
                                        <field name="partner_id"/>
                                    </span>
                                </div>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="o_kanban_record_body mb-2">
                                <div class="text-secondary small">
                                    <i class="fa fa-wrench me-1" title="Equipment/Vehicle"/> <field name="equipment_id"/>
                                </div>
                                <div class="mt-2 d-flex justify-content-between align-items-center">
                                    <span>
                                        <i class="fa fa-clock-o me-1" title="Hours"/>
                                        <strong><field name="actual_hours"/></strong> / <field name="planned_hours"/> hrs
                                    </span>
                                    <span class="fw-bold text-primary">
                                        <field name="total_cost" widget="monetary"/>
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2 pt-2 border-top d-flex justify-content-between align-items-center">
                                <div>
                                    <field name="approval_state" widget="badge"
                                           decoration-success="approval_state == 'approved'"
                                           decoration-warning="approval_state in ['supervisor_review', 'manager_review']"
                                           decoration-danger="approval_state == 'rejected'"/>
                                    <field name="vehicle_release_mode" widget="badge"
                                           invisible="not vehicle_released"
                                           decoration-success="vehicle_release_mode == 'paid'"
                                           decoration-warning="vehicle_release_mode == 'credit'"/>
                                </div>
                                <div>
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- MAIN LANDING DASHBOARD (custom OWL pipeline view) -->
    <record id="workshop_dashboard_client_action" model="ir.actions.client">
        <field name="name">Workshop Dashboard</field>
        <field name="tag">workshop_dashboard_tags</field>
    </record>

    <record id="workshop_kpi_dashboard_client_action" model="ir.actions.client">
        <field name="name">KPI Dashboard</field>
        <field name="tag">workshop_kpi_dashboard_tags</field>
    </record>

    <!-- Legacy graph dashboard (reporting) -->
    <record id="workshop_dashboard_action" model="ir.actions.act_window">
        <field name="name">Workshop Dashboard</field>
        <field name="res_model">workshop.job.order</field>
        <field name="view_mode">graph,pivot,kanban,list</field>
        <field name="view_id" ref="workshop_job_order_view_graph_pie"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Workshop Dashboard
            </p>
            <p>
                Visual pipeline overview for requests, job orders, work dispatches, and spare parts.
            </p>
        </field>
    </record>

    <!-- REPORTING: PROCESS PIPELINE REPORTING ACTION (PIVOT FIRST) -->
    <record id="action_workshop_job_order_reporting" model="ir.actions.act_window">
        <field name="name">Process Pipeline Analytics</field>
        <field name="res_model">workshop.job.order</field>
        <field name="view_mode">pivot,graph,kanban,list</field>
        <field name="view_id" ref="workshop_job_order_view_pivot"/>
    </record>

    <!-- =====================================================================
         4. DEPARTMENT UTILIZATION & TECHNICIAN WORKLOAD
         ===================================================================== -->
    <record id="workshop_work_order_view_graph_dept" model="ir.ui.view">
        <field name="name">workshop.work.order.graph.dept</field>
        <field name="model">workshop.work.order</field>
        <field name="arch" type="xml">
            <graph string="Department Hours Utilization (Pie Chart)" type="pie" sample="1">
                <field name="department"/>
                <field name="actual_hours" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="workshop_work_order_view_pivot_prod" model="ir.ui.view">
        <field name="name">workshop.work.order.pivot.prod</field>
        <field name="model">workshop.work.order</field>
        <field name="arch" type="xml">
            <pivot string="Technician Workload &amp; Productivity">
                <field name="technician_id" type="row"/>
                <field name="department" type="col"/>
                <field name="standard_hours" type="measure"/>
                <field name="planned_hours" type="measure"/>
                <field name="actual_hours" type="measure"/>
                <field name="variance_hours" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- REPORTING: TECHNICIAN PRODUCTIVITY ACTION (PIVOT FIRST) -->
    <record id="action_workshop_technician_productivity" model="ir.actions.act_window">
        <field name="name">Technician Workload &amp; Productivity</field>
        <field name="res_model">workshop.work.order</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="view_id" ref="workshop_work_order_view_pivot_prod"/>
    </record>

    <!-- =====================================================================
         5. SPARE PARTS CONSUMPTION REPORTING
         ===================================================================== -->
    <record id="workshop_spare_line_view_graph_pie" model="ir.ui.view">
        <field name="name">workshop.spare.request.line.graph.pie</field>
        <field name="model">workshop.spare.request.line</field>
        <field name="arch" type="xml">
            <graph string="Fast-Moving Spare Parts (Pie Chart)" type="pie" sample="1">
                <field name="product_id"/>
                <field name="qty_requested" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="workshop_spare_line_view_pivot" model="ir.ui.view">
        <field name="name">workshop.spare.request.line.pivot</field>
        <field name="model">workshop.spare.request.line</field>
        <field name="arch" type="xml">
            <pivot string="Spare Parts Consumption &amp; Stock Movement">
                <field name="product_id" type="row"/>
                <field name="qty_requested" type="measure"/>
                <field name="qty_issued" type="measure"/>
                <field name="total_price" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- REPORTING: SPARE PARTS REPORTING ACTION (PIVOT FIRST) -->
    <record id="action_workshop_spare_parts_reporting" model="ir.actions.act_window">
        <field name="name">Spare Parts Consumption Analytics</field>
        <field name="res_model">workshop.spare.request.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="view_id" ref="workshop_spare_line_view_pivot"/>
    </record>

</odoo>
