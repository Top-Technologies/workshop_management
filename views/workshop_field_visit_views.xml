<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="workshop_field_visit_view_list" model="ir.ui.view">
        <field name="name">workshop.field.visit.list</field>
        <field name="model">workshop.field.visit</field>
        <field name="arch" type="xml">
            <list string="Field Visits" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="job_order_id"/>
                <field name="partner_id"/>
                <field name="technician_id"/>
                <field name="scheduled_start"/>
                <field name="travel_hours"/>
                <field name="on_site_hours"/>
                <field name="dispatch_to_arrival_hours"/>
                <field name="state" widget="badge"
                       decoration-info="state in ['draft', 'scheduled']"
                       decoration-warning="state in ['traveling', 'on_site']"
                       decoration-success="state == 'completed'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="workshop_field_visit_view_calendar" model="ir.ui.view">
        <field name="name">workshop.field.visit.calendar</field>
        <field name="model">workshop.field.visit</field>
        <field name="arch" type="xml">
            <calendar string="Field Service Dispatch"
                      date_start="scheduled_start"
                      date_stop="scheduled_end"
                      color="technician_id"
                      mode="week">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="technician_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="workshop_field_visit_view_form" model="ir.ui.view">
        <field name="name">workshop.field.visit.form</field>
        <field name="model">workshop.field.visit</field>
        <field name="arch" type="xml">
            <form string="Field Visit">
                <header>
                    <button name="action_schedule" string="Schedule" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_start_travel" string="Start Travel" type="object" class="btn-info"
                            invisible="state not in ['draft', 'scheduled']"/>
                    <button name="action_check_in" string="Check In" type="object" class="btn-success"
                            invisible="state != 'traveling'"/>
                    <button name="action_check_out" string="Check Out" type="object" class="btn-warning"
                            invisible="state != 'on_site'"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"
                            invisible="state in ['completed', 'cancelled']"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,scheduled,traveling,on_site,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Assignment">
                            <field name="job_order_id" readonly="1"/>
                            <field name="request_id"/>
                            <field name="partner_id"/>
                            <field name="equipment_id"/>
                            <field name="technician_id"/>
                            <field name="user_id"/>
                        </group>
                        <group string="Schedule">
                            <field name="scheduled_start"/>
                            <field name="scheduled_end"/>
                            <field name="travel_start" readonly="1"/>
                            <field name="arrival_time" readonly="1"/>
                            <field name="departure_time" readonly="1"/>
                            <field name="return_time" readonly="1"/>
                        </group>
                    </group>
                    <group string="Service Site">
                        <group>
                            <field name="service_street"/>
                            <field name="service_city"/>
                            <field name="service_state_id"/>
                        </group>
                        <group>
                            <field name="service_country_id"/>
                        </group>
                    </group>
                    <group string="Field KPIs">
                        <group>
                            <field name="travel_hours" readonly="1"/>
                            <field name="on_site_hours" readonly="1"/>
                        </group>
                        <group>
                            <field name="dispatch_to_arrival_hours" readonly="1"/>
                        </group>
                    </group>
                    <group string="Mobile Check-In / Check-Out">
                        <group>
                            <field name="check_in_latitude"/>
                            <field name="check_in_longitude"/>
                        </group>
                        <group>
                            <field name="check_out_latitude"/>
                            <field name="check_out_longitude"/>
                        </group>
                    </group>
                    <group string="Customer Sign-Off">
                        <field name="signed_by"/>
                        <field name="customer_signature" widget="signature"/>
                    </group>
                    <notebook>
                        <page string="Visit Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="workshop_field_visit_action" model="ir.actions.act_window">
        <field name="name">Field Visits</field>
        <field name="res_model">workshop.field.visit</field>
        <field name="view_mode">calendar,list,form</field>
    </record>

    <record id="workshop_job_order_view_graph_field_service" model="ir.ui.view">
        <field name="name">workshop.job.order.graph.field.service</field>
        <field name="model">workshop.job.order</field>
        <field name="arch" type="xml">
            <graph string="In-Shop vs Field Service Jobs" type="pie" sample="1">
                <field name="service_location_type"/>
            </graph>
        </field>
    </record>

    <record id="workshop_job_order_view_pivot_field_service" model="ir.ui.view">
        <field name="name">workshop.job.order.pivot.field.service</field>
        <field name="model">workshop.job.order</field>
        <field name="arch" type="xml">
            <pivot string="Field Service KPIs">
                <field name="service_location_type" type="row"/>
                <field name="partner_id" type="col"/>
                <field name="total_travel_hours" type="measure"/>
                <field name="total_on_site_hours" type="measure"/>
                <field name="avg_dispatch_to_arrival_hours" type="measure"/>
                <field name="actual_hours" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="workshop_field_visit_view_graph_travel" model="ir.ui.view">
        <field name="name">workshop.field.visit.graph.travel</field>
        <field name="model">workshop.field.visit</field>
        <field name="arch" type="xml">
            <graph string="Travel vs On-Site Hours by Technician" type="bar" sample="1">
                <field name="technician_id"/>
                <field name="travel_hours" type="measure"/>
                <field name="on_site_hours" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_workshop_field_service_reporting" model="ir.actions.act_window">
        <field name="name">Field Service Analytics</field>
        <field name="res_model">workshop.job.order</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="view_id" ref="workshop_job_order_view_pivot_field_service"/>
        <field name="domain">[('is_field_job', '=', True)]</field>
    </record>

</odoo>
