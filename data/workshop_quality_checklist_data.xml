<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="qi_item_mech_1" model="workshop.quality.checklist.item">
            <field name="name">Mechanical systems re-checked and torqued to spec</field>
            <field name="department" ref="workshop_department_mechanical"/>
            <field name="sequence">10</field>
        </record>
        <record id="qi_item_mech_2" model="workshop.quality.checklist.item">
            <field name="name">Fluids topped / no leaks observed</field>
            <field name="department" ref="workshop_department_mechanical"/>
            <field name="sequence">20</field>
        </record>
        <record id="qi_item_elec_1" model="workshop.quality.checklist.item">
            <field name="name">Electrical connections secure; no short circuits</field>
            <field name="department" ref="workshop_department_electrical"/>
            <field name="sequence">10</field>
        </record>
        <record id="qi_item_body_1" model="workshop.quality.checklist.item">
            <field name="name">Body panels aligned; finish acceptable</field>
            <field name="department" ref="workshop_department_body"/>
            <field name="sequence">10</field>
        </record>
        <record id="qi_item_paint_1" model="workshop.quality.checklist.item">
            <field name="name">Paint finish free of defects / matching color</field>
            <field name="department" ref="workshop_department_painting"/>
            <field name="sequence">10</field>
        </record>
        <record id="qi_item_insp_1" model="workshop.quality.checklist.item">
            <field name="name">Final safety inspection completed</field>
            <field name="department" ref="workshop_department_inspection"/>
            <field name="sequence">10</field>
        </record>
        <record id="qi_item_all_1" model="workshop.quality.checklist.item">
            <field name="name">Work area cleaned; tools removed</field>
            <field name="sequence">90</field>
        </record>
        <record id="qi_item_all_2" model="workshop.quality.checklist.item">
            <field name="name">Customer complaint items addressed</field>
            <field name="sequence">100</field>
        </record>

        <!-- Default approval rules (finance can change thresholds without code) -->
        <record id="approval_rule_supervisor_default" model="workshop.approval.rule">
            <field name="name">Supervisor approval (any job)</field>
            <field name="amount_threshold">0</field>
            <field name="group_id" ref="group_workshop_supervisor"/>
        </record>
        <record id="approval_rule_manager_500k" model="workshop.approval.rule">
            <field name="name">Manager approval above 500,000</field>
            <field name="amount_threshold">500000</field>
            <field name="group_id" ref="group_workshop_manager"/>
        </record>

    </data>
</odoo>
