<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="warranty_rule_engine_overhaul_default" model="workshop.warranty.rule">
            <field name="name">Engine Overhaul — default 6 months</field>
            <field name="sequence">100</field>
            <field name="warranty_kind">engine_overhaul</field>
            <field name="duration_months">6</field>
        </record>
        <record id="warranty_rule_gearbox_default" model="workshop.warranty.rule">
            <field name="name">Gearbox — default 6 months</field>
            <field name="sequence">100</field>
            <field name="warranty_kind">gearbox</field>
            <field name="duration_months">6</field>
        </record>

        <record id="ir_cron_workshop_warranty_expire" model="ir.cron">
            <field name="name">Workshop: Expire Service Warranties</field>
            <field name="model_id" ref="model_workshop_warranty"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_warranties()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

    </data>
</odoo>
