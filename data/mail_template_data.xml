<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="email_template_job_order_approval" model="mail.template">
            <field name="name">Workshop Job Order: Approval Needed</field>
            <field name="model_id" ref="model_workshop_job_order"/>
            <field name="subject">Approval Required: Workshop Job Order {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px;">
                    <p>Dear Approver,</p>
                    <p>Workshop Job Order <strong><t t-out="object.name"/></strong> for customer <strong><t t-out="object.partner_id.name"/></strong> is waiting for your review and approval.</p>
                    <p>Total Estimated Cost: <strong><t t-out="object.total_cost"/> <t t-out="object.currency_id.name"/></strong></p>
                    <p>Thank you.</p>
                </div>
            </field>
        </record>

    </data>
</odoo>
