<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="workshop_rework_wizard_view_form" model="ir.ui.view">
        <field name="name">workshop.rework.wizard.form</field>
        <field name="model">workshop.rework.wizard</field>
        <field name="arch" type="xml">
            <form string="Send to Rework">
                <group>
                    <group>
                        <field name="work_order_id" readonly="1"/>
                        <field name="job_order_id" readonly="1"/>
                        <field name="actual_hours" widget="float_time"/>
                        <field name="extra_hours_so_far" widget="float_time"/>
                    </group>
                    <group>
                        <field name="rework_cause"/>
                        <field name="rework_who_pays"/>
                    </group>
                </group>
                <group>
                    <field name="notes" placeholder="What failed, what must be redone..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Send to Rework" type="object" class="btn-primary"/>
                    <button string="Discard" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
