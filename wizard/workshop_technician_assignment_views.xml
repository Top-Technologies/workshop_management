<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="workshop_technician_assignment_view_form" model="ir.ui.view">
        <field name="name">workshop.technician.assignment.form</field>
        <field name="model">workshop.technician.assignment</field>
        <field name="arch" type="xml">
            <form string="Assign Technicians / Create Work Pack">
                <group>
                    <group string="Job Order">
                        <field name="job_order_id" readonly="1"/>
                        <field name="is_field_job" invisible="1"/>
                        <field name="default_technician_id"/>
                    </group>
                    <group string="Field Visit" invisible="not is_field_job">
                        <field name="create_field_visit"/>
                        <field name="visit_scheduled_start" invisible="not create_field_visit"/>
                        <field name="visit_scheduled_end" invisible="not create_field_visit"/>
                    </group>
                </group>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="request_line_id" optional="hide"/>
                        <field name="name"/>
                        <field name="task_id"/>
                        <field name="department" options="{'no_quick_create': False}"/>
                        <field name="technician_id"/>
                        <field name="planned_hours"/>
                        <field name="planned_start" optional="hide"/>
                        <field name="planned_finish" optional="hide"/>
                    </list>
                </field>
                <footer>
                    <button name="action_assign_and_create_work_order"
                            string="Create Work Dispatches"
                            type="object"
                            class="btn-primary"/>
                    <button string="Discard" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
